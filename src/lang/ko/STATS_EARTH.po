#: STATS_EARTH.R:65
msgid "End of procedure"
msgstr "프로시저 끝"

#: STATS_EARTH.R:95
msgid "Message Number"
msgstr "메시지 번호"

#: STATS_EARTH.R:130
#, c-format
msgid "Invalid variable name: %s"
msgstr "잘못된 변수 이름: %s"

#: STATS_EARTH.R:152
#, c-format
msgid "Linear variables must be scale level: %s"
msgstr "선형 변수는 스케일 레벨이어야 함: %s"

#: STATS_EARTH.R:180
msgid "Earth"
msgstr "Earth"

#: STATS_EARTH.R:181
msgid "Earth Warnings"
msgstr "Earth 경고"

#: STATS_EARTH.R:200 STATS_EARTH.R:414 STATS_EARTH.R:432
msgid "earth"
msgstr "Earth"

#: STATS_EARTH.R:202
msgid "Procedure ended.  No output was requested."
msgstr "프로시저가 종료되었습니다.  출력이 요청되지 않았습니다."

#: STATS_EARTH.R:206
msgid "Case weights are ignored by this procedure"
msgstr "이 프로시저에서는 대/소문자 가중치가 무시됩니다."

#: STATS_EARTH.R:224
#, c-format
msgid "error loading model file: %s"
msgstr "모델 파일 로드 중 오류 발생: %s"

#: STATS_EARTH.R:230
#, c-format
msgid ""
"Model loaded from file: %s and will be used for any requested plots and "
"predictions"
msgstr "파일 %s에서 로드된 모델이며 요청된 플롯 및 예측에 사용됩니다."

#: STATS_EARTH.R:233
msgid "Model will not be resaved"
msgstr "모델이 다시 저장되지 않습니다."

#: STATS_EARTH.R:240
msgid "An ID variable must be specified if predictions are requested"
msgstr "예측을 요청하는 경우 ID 변수를 지정해야 합니다."

#: STATS_EARTH.R:245
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr "지정한 예측 데이터 세트가 이미 존재합니다.  닫거나 다른 이름 선택"

#: STATS_EARTH.R:249
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr "예측을 수행하는 경우 입력 데이터 세트에 이름이 있어야 합니다.  하나를 지정하고 프로시저를 다시 실행하십시오."

#: STATS_EARTH.R:261
msgid "Split files is not supported by this procedure"
msgstr "이 프로시저에서는 파일 분할이 지원되지 않습니다."

#: STATS_EARTH.R:270
msgid ""
"Dependent and independent or linear variables must be specified when "
"estimating"
msgstr "추정할 때 종속 변수 및 독립 변수 또는 선형 변수를 지정해야 합니다."

#: STATS_EARTH.R:274
msgid "The dependent variable appears in the independent variable list"
msgstr "종속 변수는 독립 변수 목록에 표시됩니다."

#: STATS_EARTH.R:284
msgid ""
"Number of folds must be > 1 to use multiple crossvalidation.  Ignorning"
msgstr "다중 교차 유효성 검증을 사용하려면 접기 횟수가 1보다 커야 합니다.  무시 중"

#: STATS_EARTH.R:293
msgid "error fetching data"
msgstr "데이터 페치 중 오류 발생"

#: STATS_EARTH.R:300
msgid "There are no complete cases in the data"
msgstr "데이터에 완전한 케이스가 없음"

#: STATS_EARTH.R:325
msgid "error estimating equation"
msgstr "방정식 추정 중 오류 발생"

#: STATS_EARTH.R:346
#, c-format
msgid "Estimated model saved to file %s"
msgstr "%s 파일에 저장된 추정 모델"

#: STATS_EARTH.R:348
#, c-format
msgid "Model saving to file %sfailed"
msgstr "%s 파일에 모델 저장 실패"

#: STATS_EARTH.R:356
msgid "There is no estimated model to use for plots."
msgstr "플롯에 사용할 예측 모델이 없습니다."

#: STATS_EARTH.R:454
msgid "Generalized Cross Validation"
msgstr "일반화된 교차 유효성 검증"

#: STATS_EARTH.R:455
msgid "Residual Sum of Squares"
msgstr "잔차 제곱합"

#: STATS_EARTH.R:455
msgid "Standardized GCV"
msgstr "표준화된 GCV"

#: STATS_EARTH.R:455
msgid "R Squared"
msgstr "R 제곱"

#: STATS_EARTH.R:461
msgid "Mean CV Rsq"
msgstr "평균 CV Rsq"

#: STATS_EARTH.R:465
msgid "Fit Summary"
msgstr "적합성 요약"

#: STATS_EARTH.R:466
msgid "Summary"
msgstr "요약(M)"

#: STATS_EARTH.R:468 STATS_EARTH.R:479 STATS_EARTH.R:493
#, c-format
msgid "Dependent variable: %s"
msgstr "종속 변수: %s"

#: STATS_EARTH.R:476
msgid "Coefficients"
msgstr "계수"

#: STATS_EARTH.R:477
msgid "Earth Coefficients"
msgstr "Earth 계수"

#: STATS_EARTH.R:485
msgid "subsets Including Variable"
msgstr "변수 포함 서브세트"

#: STATS_EARTH.R:485
msgid "Generalized Cross Validation Reduction"
msgstr "일반화된 교차 유효성 검증 감소"

#: STATS_EARTH.R:486
msgid "Residual Sum of Squares Reduction"
msgstr "잔여 제곱합 감소"

#: STATS_EARTH.R:490 STATS_EARTH.R:491
msgid "Variable Importance"
msgstr "변수 중요도"

#: STATS_EARTH.R:504
msgid "Dependent Variable"
msgstr "종속변수"

#: STATS_EARTH.R:505
msgid "Independent Variables"
msgstr "독립변수"

#: STATS_EARTH.R:506
msgid "Maximum Interaction Degree Allowed"
msgstr "허용되는 최대 상호작용 정도"

#: STATS_EARTH.R:507
msgid "Cross-Validation Folds"
msgstr "교차 검증 중첩"

#: STATS_EARTH.R:508
msgid "Cross Validations"
msgstr "교차 유효성 검증"

#: STATS_EARTH.R:509
msgid "Distribution Family"
msgstr "분포 군"

#: STATS_EARTH.R:510
msgid "Maximum Terms"
msgstr "최대 기간"

#: STATS_EARTH.R:511
msgid "Estimation Date"
msgstr "추정 날짜"

#: STATS_EARTH.R:512
msgid "Number of Complete Cases"
msgstr "완전한 케이스 수"

#: STATS_EARTH.R:513
msgid "Prediction Dataset"
msgstr "예측 데이터 세트"

#: STATS_EARTH.R:514
msgid "Prediction Threshold"
msgstr "예측 임계값"

#: STATS_EARTH.R:515
msgid "Saved Model File"
msgstr "저장된 모델 파일"

#: STATS_EARTH.R:536 STATS_EARTH.R:537
msgid "Earth Parameters"
msgstr "Earth 매개변수"

#: STATS_EARTH.R:539
#, c-format
msgid "Computations from R earth package, version %s"
msgstr "R Earth 패키지, 버전 %s에서 계산"

#: STATS_EARTH.R:556
msgid "Distribution plots are not available for scale variables"
msgstr "스케일 변수에 대해 분포도를 사용할 수 없음"

#: STATS_EARTH.R:614
#, c-format
msgid ""
"Plot drawing failure\n"
"%s"
msgstr ""
"플롯 그리기 실패\n"
"%s"

#: STATS_EARTH.R:670
msgid "Prediction type class is only for factors"
msgstr "예측 유형 클래스는 요인에만 적용됩니다."

#: STATS_EARTH.R:676
msgid ""
"No ID variable was specified in estimation.  Predictions cannot be made"
msgstr "추정 시 ID 변수가 지정되지 않았습니다.  예측할 수 없음"

#: STATS_EARTH.R:694
msgid "error fetching new prediction data"
msgstr "새 예측 데이터 페치 중 오류 발생"

#: STATS_EARTH.R:699
msgid "Prediction data source is new data"
msgstr "예측 데이터 소스는 새 데이터입니다."
