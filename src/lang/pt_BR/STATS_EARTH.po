#: STATS_EARTH.R:65
msgid "End of procedure"
msgstr "Fim do procedimento"

#: STATS_EARTH.R:95
msgid "Message Number"
msgstr "Número da mensagem"

#: STATS_EARTH.R:130
#, c-format
msgid "Invalid variable name: %s"
msgstr "Nome de variável inválido: %s"

#: STATS_EARTH.R:152
#, c-format
msgid "Linear variables must be scale level: %s"
msgstr "As variáveis lineares devem estar em nível de escala: %s"

#: STATS_EARTH.R:180
msgid "Earth"
msgstr "Earth"

#: STATS_EARTH.R:181
msgid "Earth Warnings"
msgstr "Avisos do earth"

#: STATS_EARTH.R:200 STATS_EARTH.R:414 STATS_EARTH.R:432
msgid "earth"
msgstr "earth"

#: STATS_EARTH.R:202
msgid "Procedure ended.  No output was requested."
msgstr "Procedimento encerrado.  Nenhuma saída foi solicitada."

#: STATS_EARTH.R:206
msgid "Case weights are ignored by this procedure"
msgstr "As ponderações de caso são ignoradas por este procedimento"

#: STATS_EARTH.R:224
#, c-format
msgid "error loading model file: %s"
msgstr "erro ao carregar o arquivo de modelo: %s"

#: STATS_EARTH.R:230
#, c-format
msgid ""
"Model loaded from file: %s and will be used for any requested plots and "
"predictions"
msgstr ""
"Modelo carregado do arquivo: %s e será usado para todos os gráficos e "
"predições solicitados"

#: STATS_EARTH.R:233
msgid "Model will not be resaved"
msgstr "O modelo não será salvo novamente"

#: STATS_EARTH.R:240
msgid "An ID variable must be specified if predictions are requested"
msgstr ""
"Deve-se especificar uma variável de ID caso predições sejam solicitadas"

#: STATS_EARTH.R:245
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"O conjunto de dados de predição especificado já existe.  Feche-o ou escolha "
"um nome diferente"

#: STATS_EARTH.R:249
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"O conjunto de dados de entrada deve ter um nome caso esteja fazendo "
"predições  Designe um e execute novamente o procedimento"

#: STATS_EARTH.R:261
msgid "Split files is not supported by this procedure"
msgstr "A divisão de arquivos não é suportada por este procedimento"

#: STATS_EARTH.R:270
msgid ""
"Dependent and independent or linear variables must be specified when "
"estimating"
msgstr ""
"Variáveis dependentes e independentes ou lineares devem ser especificadas ao"
" estimar"

#: STATS_EARTH.R:274
msgid "The dependent variable appears in the independent variable list"
msgstr "A variável dependente aparece na lista de variáveis independentes"

#: STATS_EARTH.R:284
msgid ""
"Number of folds must be > 1 to use multiple crossvalidation.  Ignorning"
msgstr ""
"O número de dobras deve ser > 1 para usar validação cruzada múltipla.  "
"Ignorando"

#: STATS_EARTH.R:293
msgid "error fetching data"
msgstr "erro ao buscar dados"

#: STATS_EARTH.R:300
