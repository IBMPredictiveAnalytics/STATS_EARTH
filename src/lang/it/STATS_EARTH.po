#: STATS_EARTH.R:65
msgid "End of procedure"
msgstr "Fine della procedura"

#: STATS_EARTH.R:95
msgid "Message Number"
msgstr "Numero di messaggio"

#: STATS_EARTH.R:130
#, c-format
msgid "Invalid variable name: %s"
msgstr "Nome di variabile non valido: %s"

#: STATS_EARTH.R:152
#, c-format
msgid "Linear variables must be scale level: %s"
msgstr "Le variabili lineari devono essere a livello di scala: %s"

#: STATS_EARTH.R:180
msgid "Earth"
msgstr "Earth"

#: STATS_EARTH.R:181
msgid "Earth Warnings"
msgstr "Avvertenze per Earth"

#: STATS_EARTH.R:200 STATS_EARTH.R:414 STATS_EARTH.R:432
msgid "earth"
msgstr "earth"

#: STATS_EARTH.R:202
msgid "Procedure ended.  No output was requested."
msgstr "Procedura conclusa.  Non è stato richiesto alcun output."

#: STATS_EARTH.R:206
msgid "Case weights are ignored by this procedure"
msgstr "I pesi dei casi vengono ignorati da questa procedura"

#: STATS_EARTH.R:224
#, c-format
msgid "error loading model file: %s"
msgstr "errore nel caricamento del file del modello: %s"

#: STATS_EARTH.R:230
#, c-format
msgid ""
"Model loaded from file: %s and will be used for any requested plots and "
"predictions"
msgstr ""
"Il modello è stato caricato dal file: %s e sarà utilizzato per tutti i "
"grafici e le previsioni richieste"

#: STATS_EARTH.R:233
msgid "Model will not be resaved"
msgstr "Il modello non verrà salvato di nuovo"

#: STATS_EARTH.R:240
msgid "An ID variable must be specified if predictions are requested"
msgstr "Una variabile ID deve essere specificata se si richiedono previsioni"

#: STATS_EARTH.R:245
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"Il set di dati di previsione specificato esiste già.  Chiuderlo oppure "
"scegliere un altro nome"

#: STATS_EARTH.R:249
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"Il set di dati di input deve avere un nome se si effettuano previsioni.  "
"Assegnarne uno e ripetere la procedura."

#: STATS_EARTH.R:261
msgid "Split files is not supported by this procedure"
msgstr "La suddivisione dei file non è supportata da questa procedura"

#: STATS_EARTH.R:270
msgid ""
"Dependent and independent or linear variables must be specified when "
"estimating"
msgstr ""
"Le variabili dipendenti e indipendenti o lineari devono essere specificate "
"quando si effettua la stima"

#: STATS_EARTH.R:274
msgid "The dependent variable appears in the independent variable list"
msgstr ""
"La variabile dipendente appare nell'elenco delle variabili indipendenti"

#: STATS_EARTH.R:284
msgid ""
"Number of folds must be > 1 to use multiple crossvalidation.  Ignorning"
msgstr ""
"Il numero di fold deve essere > 1 per utilizzare la convalida incrociata "
"multipla.  Ignorato"

#: STATS_EARTH.R:293
msgid "error fetching data"
msgstr "errore nel richiamo dei dati"

#: STATS_EARTH.R:300
msgid "There are no complete cases in the data"
msgstr "Non ci sono casi completi nei dati"

#: STATS_EARTH.R:325
msgid "error estimating equation"
msgstr "equazione di stima dell'errore"

#: STATS_EARTH.R:346
#, c-format
msgid "Estimated model saved to file %s"
msgstr "Modello stimato salvato nel file %s"

#: STATS_EARTH.R:348
#, c-format
msgid "Model saving to file %sfailed"
msgstr "Salvataggio del modello nel file %s non riuscito"

#: STATS_EARTH.R:356
msgid "There is no estimated model to use for plots."
msgstr "Non esiste un modello stimato da utilizzare per i grafici."

#: STATS_EARTH.R:454
msgid "Generalized Cross Validation"
msgstr "Convalida incrociata generalizzata"

#: STATS_EARTH.R:455
msgid "Residual Sum of Squares"
msgstr "Somma dei quadrati residui"

#: STATS_EARTH.R:455
msgid "Standardized GCV"
msgstr "GCV standardizzati"

#: STATS_EARTH.R:455
msgid "R Squared"
msgstr "R-quadrato"

#: STATS_EARTH.R:461
msgid "Mean CV Rsq"
msgstr "Rsq CV medio"

#: STATS_EARTH.R:465
msgid "Fit Summary"
msgstr "Riepilogo di adattamento"

#: STATS_EARTH.R:466
msgid "Summary"
msgstr "Riepilogo"

#: STATS_EARTH.R:468 STATS_EARTH.R:479 STATS_EARTH.R:493
#, c-format
msgid "Dependent variable: %s"
msgstr "Variabile dipendente: %s"

#: STATS_EARTH.R:476
msgid "Coefficients"
msgstr "Coefficienti"

#: STATS_EARTH.R:477
msgid "Earth Coefficients"
msgstr "Coefficienti di Earth"

#: STATS_EARTH.R:485
msgid "subsets Including Variable"
msgstr "sottoinsiemi che includono la variabile"

#: STATS_EARTH.R:485
msgid "Generalized Cross Validation Reduction"
msgstr "Riduzione della convalida incrociata generalizzata"

#: STATS_EARTH.R:486
msgid "Residual Sum of Squares Reduction"
msgstr "Riduzione della somma dei quadrati residui"

#: STATS_EARTH.R:490 STATS_EARTH.R:491
msgid "Variable Importance"
msgstr "Importanza delle variabili"

#: STATS_EARTH.R:504
msgid "Dependent Variable"
msgstr "Variabile dipendente"

#: STATS_EARTH.R:505
msgid "Independent Variables"
msgstr "Variabili indipendenti"

#: STATS_EARTH.R:506
msgid "Maximum Interaction Degree Allowed"
msgstr "Massimo grado di interazione consentito"

#: STATS_EARTH.R:507
msgid "Cross-Validation Folds"
msgstr "Occorrenze con convalida incrociata"

#: STATS_EARTH.R:508
msgid "Cross Validations"
msgstr "Convalide incrociate"

#: STATS_EARTH.R:509
msgid "Distribution Family"
msgstr "Famiglia di distribuzione"

#: STATS_EARTH.R:510
msgid "Maximum Terms"
msgstr "Numero massimo di termini"

#: STATS_EARTH.R:511
msgid "Estimation Date"
msgstr "Data della stima"

#: STATS_EARTH.R:512
msgid "Number of Complete Cases"
msgstr "Numero di casi completi"

#: STATS_EARTH.R:513
msgid "Prediction Dataset"
msgstr "Dataset di previsione"

#: STATS_EARTH.R:514
msgid "Prediction Threshold"
msgstr "Soglia di previsione"

#: STATS_EARTH.R:515
msgid "Saved Model File"
msgstr "File del modello salvato"

#: STATS_EARTH.R:536 STATS_EARTH.R:537
msgid "Earth Parameters"
msgstr "Parametri di Earth"

#: STATS_EARTH.R:539
#, c-format
msgid "Computations from R earth package, version %s"
msgstr "Calcoli dal pacchetto R earth, versione %s"

#: STATS_EARTH.R:556
msgid "Distribution plots are not available for scale variables"
msgstr ""
"I grafici di distribuzione non sono disponibili per le variabili di scala"

#: STATS_EARTH.R:614
#, c-format
msgid ""
"Plot drawing failure\n"
"%s"
msgstr ""
"Errore nel disegno del grafico\n"
"%s"

#: STATS_EARTH.R:670
msgid "Prediction type class is only for factors"
msgstr "La classe del tipo di previsione è solo per i fattori"

#: STATS_EARTH.R:676
msgid ""
"No ID variable was specified in estimation.  Predictions cannot be made"
msgstr ""
"Nella stima non è stata specificata alcuna variabile ID.  Non è possibile "
"fare previsioni"

#: STATS_EARTH.R:694
msgid "error fetching new prediction data"
msgstr "errore nell'acquisizione di nuovi dati di previsione"

#: STATS_EARTH.R:699
msgid "Prediction data source is new data"
msgstr "L'origine dei dati di previsione è costituita da nuovi dati"
