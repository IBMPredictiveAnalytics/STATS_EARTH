#: STATS_EARTH.R:65
msgid "End of procedure"
msgstr "Ende der Prozedur"

#: STATS_EARTH.R:95
msgid "Message Number"
msgstr "Nachrichtennummer"

#: STATS_EARTH.R:130
#, c-format
msgid "Invalid variable name: %s"
msgstr "Ungültiger Variablenname: %s"

#: STATS_EARTH.R:152
#, c-format
msgid "Linear variables must be scale level: %s"
msgstr "Lineare Variablen müssen metrisches Niveau haben: %s"

#: STATS_EARTH.R:180
msgid "Earth"
msgstr "Erde"

#: STATS_EARTH.R:181
msgid "Earth Warnings"
msgstr "Erde – Warnungen"

#: STATS_EARTH.R:200 STATS_EARTH.R:414 STATS_EARTH.R:432
msgid "earth"
msgstr "Erde"

#: STATS_EARTH.R:202
msgid "Procedure ended.  No output was requested."
msgstr "Verfahren beendet.  Es wurde keine Ausgabe angefordert."

#: STATS_EARTH.R:206
msgid "Case weights are ignored by this procedure"
msgstr "Bei diesem Verfahren werden Fallgewichtungen ignoriert"

#: STATS_EARTH.R:224
#, c-format
msgid "error loading model file: %s"
msgstr "Fehler beim Laden von Modelldatei: %s"

#: STATS_EARTH.R:230
#, c-format
msgid ""
"Model loaded from file: %s and will be used for any requested plots and "
"predictions"
msgstr ""
"Das Modell wurde aus der Datei %s geladen und wird für alle angeforderten "
"Diagramme und Vorhersagen verwendet"

#: STATS_EARTH.R:233
msgid "Model will not be resaved"
msgstr "Das Modell wird nicht erneut gespeichert"

#: STATS_EARTH.R:240
msgid "An ID variable must be specified if predictions are requested"
msgstr ""
"Wenn Vorhersagen angefordert werden, muss eine ID-Variable angegeben werden"

#: STATS_EARTH.R:245
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"Das angegebene Vorhersagedataset ist bereits vorhanden.  Schließen Sie es "
"oder wählen Sie einen anderen Namen aus"

#: STATS_EARTH.R:249
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"Das Eingabedataset muss einen Namen haben, wenn Vorhersagen mit ihm "
"durchgeführt werden.  Weisen Sie ihm einen Namen zu und führen Sie das "
"Verfahren erneut aus."

#: STATS_EARTH.R:261
msgid "Split files is not supported by this procedure"
msgstr "Das Teilen von Dateien wird von diesem Verfahren nicht unterstützt"

#: STATS_EARTH.R:270
msgid ""
"Dependent and independent or linear variables must be specified when "
"estimating"
msgstr ""
"Abhängige und unabhängige oder lineare Variablen müssen bei der Durchführung"
" einer Schätzung angegeben werden"

#: STATS_EARTH.R:274
msgid "The dependent variable appears in the independent variable list"
msgstr ""
"Die abhängige Variable wird in der Liste der unabhängigen Variablen "
"aufgeführt"

#: STATS_EARTH.R:284
msgid ""
"Number of folds must be > 1 to use multiple crossvalidation.  Ignorning"
msgstr ""
"Die Anzahl der Faltungen muss >1 sein, damit die mehrfache Kreuzvalidierung "
"verwendet werden kann.  Ignorieren von"

#: STATS_EARTH.R:293
msgid "error fetching data"
msgstr "Fehler beim Abrufen von Daten"

#: STATS_EARTH.R:300
msgid "There are no complete cases in the data"
msgstr "Die Daten enthalten keine vollständigen Fälle"

#: STATS_EARTH.R:325
msgid "error estimating equation"
msgstr "Fehler bei Schätzungsgleichung"

#: STATS_EARTH.R:346
#, c-format
msgid "Estimated model saved to file %s"
msgstr "Geschätztes Modell wurde in Datei %s gespeichert"

#: STATS_EARTH.R:348
#, c-format
msgid "Model saving to file %sfailed"
msgstr "Speichern des Modells in Datei %s fehlgeschlagen"

#: STATS_EARTH.R:356
msgid "There is no estimated model to use for plots."
msgstr ""
"Es ist kein geschätztes Modell vorhanden, das für Diagramme verwendet werden"
" könnte."

#: STATS_EARTH.R:454
msgid "Generalized Cross Validation"
msgstr "Verallgemeinerte Kreuzvalidierung (GCV)"

#: STATS_EARTH.R:455
msgid "Residual Sum of Squares"
msgstr "Residuenquadratsumme"

#: STATS_EARTH.R:455
msgid "Standardized GCV"
msgstr "Standardisierte verallgemeinerte Kreuzvalidierung (GCSV)"

#: STATS_EARTH.R:455
msgid "R Squared"
msgstr "R-Quadrat"

#: STATS_EARTH.R:461
msgid "Mean CV Rsq"
msgstr "Mittlere Kreuzvalidierung R zum Quadrat (CV Rsq)"

#: STATS_EARTH.R:465
msgid "Fit Summary"
msgstr "Zusammenfassung der Eignung"

#: STATS_EARTH.R:466
msgid "Summary"
msgstr "Zusammenfassung"

#: STATS_EARTH.R:468 STATS_EARTH.R:479 STATS_EARTH.R:493
#, c-format
msgid "Dependent variable: %s"
msgstr "Abhängige Variable: %s"

#: STATS_EARTH.R:476
msgid "Coefficients"
msgstr "Koeffizienten"

#: STATS_EARTH.R:477
msgid "Earth Coefficients"
msgstr "Erde – Koeffizienten"

#: STATS_EARTH.R:485
msgid "subsets Including Variable"
msgstr "Teilmengen einschließlich Variabler"

#: STATS_EARTH.R:485
msgid "Generalized Cross Validation Reduction"
msgstr "Verkleinerung der verallgemeinerten Kreuzvalidierung"

#: STATS_EARTH.R:486
msgid "Residual Sum of Squares Reduction"
msgstr "Verkleinerung der Residuenquadratsumme"

#: STATS_EARTH.R:490 STATS_EARTH.R:491
msgid "Variable Importance"
msgstr "Variablenstellenwert"

#: STATS_EARTH.R:504
msgid "Dependent Variable"
msgstr "Abhängige Variable"

#: STATS_EARTH.R:505
msgid "Independent Variables"
msgstr "Unabhängige Variablen"

#: STATS_EARTH.R:506
msgid "Maximum Interaction Degree Allowed"
msgstr "Maximal zulässiger Interaktionsgrad"

#: STATS_EARTH.R:507
msgid "Cross-Validation Folds"
msgstr "Kreuzvalidierungsaufteilungen"

#: STATS_EARTH.R:508
msgid "Cross Validations"
msgstr "Kreuzvalidierungen"

#: STATS_EARTH.R:509
msgid "Distribution Family"
msgstr "Verteilungsfamilie"

#: STATS_EARTH.R:510
msgid "Maximum Terms"
msgstr "Maximale Anzahl von Begriffen"

#: STATS_EARTH.R:511
msgid "Estimation Date"
msgstr "Schätzungsdatum"

#: STATS_EARTH.R:512
msgid "Number of Complete Cases"
msgstr "Anzahl der abgeschlossenen Fälle"

#: STATS_EARTH.R:513
msgid "Prediction Dataset"
msgstr "Vorhersagedataset"

#: STATS_EARTH.R:514
msgid "Prediction Threshold"
msgstr "Schwellenwert für Vorhersage"

#: STATS_EARTH.R:515
msgid "Saved Model File"
msgstr "Gespeicherte Modelldatei"

#: STATS_EARTH.R:536 STATS_EARTH.R:537
msgid "Earth Parameters"
msgstr "Erdparameter"

#: STATS_EARTH.R:539
#, c-format
msgid "Computations from R earth package, version %s"
msgstr "Berechnungen aus dem Erdpaket R, Version %s"

#: STATS_EARTH.R:556
msgid "Distribution plots are not available for scale variables"
msgstr "Verteilungsdiagramme sind für metrische Variablen nicht verfügbar"

#: STATS_EARTH.R:614
#, c-format
msgid ""
"Plot drawing failure\n"
"%s"
msgstr ""
"Zeichnen von Diagramm fehlgeschlagen: \n"
"%s"

#: STATS_EARTH.R:670
msgid "Prediction type class is only for factors"
msgstr "Die Klasse der Vorhersagetypen gilt nur für Faktoren"

#: STATS_EARTH.R:676
msgid ""
"No ID variable was specified in estimation.  Predictions cannot be made"
msgstr ""
"Bei der Schätzung wurde keine ID-Variable angegeben.  Es können keine "
"Vorhersagen gemacht werden"

#: STATS_EARTH.R:694
msgid "error fetching new prediction data"
msgstr "Fehler beim Abrufen neuer Prognosedaten"

#: STATS_EARTH.R:699
msgid "Prediction data source is new data"
msgstr "Die Vorhersagedatenquelle hat neue Daten"
