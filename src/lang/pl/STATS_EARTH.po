#: STATS_EARTH.R:65
msgid "End of procedure"
msgstr "Koniec procedury"

#: STATS_EARTH.R:95
msgid "Message Number"
msgstr "Numer komunikatu"

#: STATS_EARTH.R:130
#, c-format
msgid "Invalid variable name: %s"
msgstr "Niepoprawna nazwa zmiennej: %s"

#: STATS_EARTH.R:152
#, c-format
msgid "Linear variables must be scale level: %s"
msgstr "Zmienne liniowe muszą mieć poziom skali: %s"

#: STATS_EARTH.R:180
msgid "Earth"
msgstr "Earth"

#: STATS_EARTH.R:181
msgid "Earth Warnings"
msgstr "Ostrzeżenia pakietu Earth"

#: STATS_EARTH.R:200 STATS_EARTH.R:414 STATS_EARTH.R:432
msgid "earth"
msgstr "earth"

#: STATS_EARTH.R:202
msgid "Procedure ended.  No output was requested."
msgstr ""
"Procedura została zakończona.  Nie zażądano żadnych danych wyjściowych."

#: STATS_EARTH.R:206
msgid "Case weights are ignored by this procedure"
msgstr "Ta procedura ignoruje wagi przypadków"

#: STATS_EARTH.R:224
#, c-format
msgid "error loading model file: %s"
msgstr "błąd ładowania pliku modelu: %s"

#: STATS_EARTH.R:230
#, c-format
msgid ""
"Model loaded from file: %s and will be used for any requested plots and "
"predictions"
msgstr ""
"Model został załadowany z pliku %s i będzie używany do wszelkich wymaganych "
"wykresów i prognoz"

#: STATS_EARTH.R:233
msgid "Model will not be resaved"
msgstr "Model nie zostanie ponownie zapisany"

#: STATS_EARTH.R:240
msgid "An ID variable must be specified if predictions are requested"
msgstr "Zmienna ID musi zostać określona, jeśli wymagane są prognozy"

#: STATS_EARTH.R:245
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"Określony zestaw danych prognozy już istnieje.  Zamknij go lub wybierz inną "
"nazwę"

#: STATS_EARTH.R:249
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"W przypadku prognozy wejściowy zestaw danych musi mieć nazwę.  Przypisz ją i"
" uruchom procedurę ponownie."

#: STATS_EARTH.R:261
msgid "Split files is not supported by this procedure"
msgstr "Ta procedura nie obsługuje dzielenia plików"

#: STATS_EARTH.R:270
msgid ""
"Dependent and independent or linear variables must be specified when "
"estimating"
msgstr ""
"Podczas szacowania należy określić zmienne zależne i niezależne albo liniowe"

#: STATS_EARTH.R:274
msgid "The dependent variable appears in the independent variable list"
msgstr "Zmienna zależna pojawia się na liście zmiennych niezależnych"

#: STATS_EARTH.R:284
msgid ""
"Number of folds must be > 1 to use multiple crossvalidation.  Ignorning"
msgstr ""
"Aby użyć wielokrotnej walidacji krzyżowej, liczba krotności musi być większa"
" od 1.  Ignorowanie"

#: STATS_EARTH.R:293
msgid "error fetching data"
msgstr "błąd pobierania danych"

#: STATS_EARTH.R:300
msgid "There are no complete cases in the data"
msgstr "W danych nie ma kompletnych przypadków"

#: STATS_EARTH.R:325
msgid "error estimating equation"
msgstr "równanie szacowania błędu"

#: STATS_EARTH.R:346
#, c-format
msgid "Estimated model saved to file %s"
msgstr "Oszacowany model został zapisany w pliku %s"

#: STATS_EARTH.R:348
#, c-format
msgid "Model saving to file %sfailed"
msgstr "Zapisanie modelu w pliku %s się nie powiodło"

#: STATS_EARTH.R:356
msgid "There is no estimated model to use for plots."
msgstr "Nie ma oszacowanego modelu, którego można użyć na wykresach."

#: STATS_EARTH.R:454
msgid "Generalized Cross Validation"
msgstr "Uogólniona walidacja krzyżowa"

#: STATS_EARTH.R:455
msgid "Residual Sum of Squares"
msgstr "Resztowa suma kwadratów"

#: STATS_EARTH.R:455
msgid "Standardized GCV"
msgstr "Znormalizowana uogólniona walidacja krzyżowa"

#: STATS_EARTH.R:455
msgid "R Squared"
msgstr "R kwadrat"

#: STATS_EARTH.R:461
msgid "Mean CV Rsq"
msgstr "Średnia wsp. determinacji walidacji krzyżowej"

#: STATS_EARTH.R:465
msgid "Fit Summary"
msgstr "Podsumowanie dopasowania"

#: STATS_EARTH.R:466
msgid "Summary"
msgstr "Podsumowanie"

#: STATS_EARTH.R:468 STATS_EARTH.R:479 STATS_EARTH.R:493
#, c-format
msgid "Dependent variable: %s"
msgstr "Zmienna zależna: %s"

#: STATS_EARTH.R:476
msgid "Coefficients"
msgstr "Współczynniki"

#: STATS_EARTH.R:477
msgid "Earth Coefficients"
msgstr "Współczynniki pakietu Earth"

#: STATS_EARTH.R:485
msgid "subsets Including Variable"
msgstr "podzbiory obejmujące zmienną"

#: STATS_EARTH.R:485
msgid "Generalized Cross Validation Reduction"
msgstr "Redukcja uogólnionej walidacji krzyżowej"

#: STATS_EARTH.R:486
msgid "Residual Sum of Squares Reduction"
msgstr "Redukcja sumy kwadratów reszt"

#: STATS_EARTH.R:490 STATS_EARTH.R:491
msgid "Variable Importance"
msgstr "Ważność zmiennych"

#: STATS_EARTH.R:504
msgid "Dependent Variable"
msgstr "Zmienna zależna"

#: STATS_EARTH.R:505
msgid "Independent Variables"
msgstr "Zmienne niezależne"

#: STATS_EARTH.R:506
msgid "Maximum Interaction Degree Allowed"
msgstr "Maksymalny dozwolony stopień interakcji"

#: STATS_EARTH.R:507
msgid "Cross-Validation Folds"
msgstr "Krotność walidacji krzyżowych"

#: STATS_EARTH.R:508
msgid "Cross Validations"
msgstr "Walidacje krzyżowe"

#: STATS_EARTH.R:509
msgid "Distribution Family"
msgstr "Rodzina rozkładów"

#: STATS_EARTH.R:510
msgid "Maximum Terms"
msgstr "Składniki maksymalne"

#: STATS_EARTH.R:511
msgid "Estimation Date"
msgstr "Data oszacowania"

#: STATS_EARTH.R:512
msgid "Number of Complete Cases"
msgstr "Liczba kompletnych przypadków"

#: STATS_EARTH.R:513
msgid "Prediction Dataset"
msgstr "Zbiór danych predykcyjnych"

#: STATS_EARTH.R:514
msgid "Prediction Threshold"
msgstr "Próg predykcji"

#: STATS_EARTH.R:515
msgid "Saved Model File"
msgstr "Plik zapisanego modelu"

#: STATS_EARTH.R:536 STATS_EARTH.R:537
msgid "Earth Parameters"
msgstr "Parametry pakietu Earth"

#: STATS_EARTH.R:539
#, c-format
msgid "Computations from R earth package, version %s"
msgstr "Obliczenia z pakietu R Earth, wersja %s"

#: STATS_EARTH.R:556
msgid "Distribution plots are not available for scale variables"
msgstr "Wykresy rozkładu nie są dostępne dla zmiennych skali"

#: STATS_EARTH.R:614
#, c-format
msgid ""
"Plot drawing failure\n"
"%s"
msgstr ""
"Błąd wykreślania wykresu \n"
"%s"

#: STATS_EARTH.R:670
msgid "Prediction type class is only for factors"
msgstr "Klasa typu predykcji jest przeznaczona tylko dla czynników"

#: STATS_EARTH.R:676
msgid ""
"No ID variable was specified in estimation.  Predictions cannot be made"
msgstr ""
"W oszacowaniu nie określono zmiennej ID.  Nie można wygenerować predykcji"

#: STATS_EARTH.R:694
msgid "error fetching new prediction data"
msgstr "błąd pobierania nowych danych predykcyjnych"

#: STATS_EARTH.R:699
msgid "Prediction data source is new data"
msgstr "Źródłem danych predykcyjnych są nowe dane"
